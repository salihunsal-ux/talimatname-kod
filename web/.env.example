# Panel ayarları. Gerçek değerler .env.local dosyasına yazılır (depoya girmez).

# Boş bırakın: panel API'yi kendi kaynağından çağırır ve Vite /api'yi
# backend'e aktarır (vite.config.ts · VITE_API_TARGET).
VITE_API_URL=

# Backend başka bir portta çalışıyorsa yalnızca bunu değiştirin.
VITE_API_TARGET=http://127.0.0.1:8020

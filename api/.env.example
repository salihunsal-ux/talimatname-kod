# Talimatname API — yerel geliştirme ayarları (ADR-0014 md.12)
# Gerçek değerler asla depoya girmez.

ENVIRONMENT=dev
LOG_LEVEL=INFO

# Standart PostgreSQL URL'si. Sağlayıcıdan bağımsızdır (ADR-0012 md.4):
# yerel kurulum, Docker ya da ücretsiz bulut Postgres — hepsi aynı satır.
# Boş bırakılırsa veritabanı gerektirmeyen uç noktalar ve saf testler çalışır.
DATABASE_URL=

# S3 uyumlu nesne depolama (kanıt dosyaları). dev'de boş: yerel dizin adaptörü.
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_BUCKET=

# Yalnızca staging'de açılır (zamanlayıcı testleri). prod'da açıksa uygulama açılmaz.
TIME_TRAVEL_ENABLED=false

ACCESS_TOKEN_MINUTES=30

# Ortam değişkenleri örneği. Kopyalayın: cp .env.example .env
# .env **asla commit edilmez** (.gitignore).

ENVIRONMENT=dev
LOG_LEVEL=INFO

# Boş bırakılırsa bellek içi adaptör kullanılır (panel veritabanısız açılır).
# Dolduruken: infra/veritabani-kurulum.md
DATABASE_URL=

# Belirteç imzası (RS256). dev'de boş bırakılabilir: süreç açılışında
# geçici bir anahtar çifti üretilir ve günlüğe uyarı yazılır — sunucu
# yeniden başlayınca eldeki belirteçler geçersiz olur.
# staging/prod'da zorunludur; satır içi yeni satırlar \n ile yazılır.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ACCESS_TOKEN_MINUTES=30

# Kanıt dosyaları (ST-034'te bağlanacak).
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_BUCKET=

# Yerel adaptörün kanıt dizini (S3 bağlanana kadar).
EVIDENCE_DIR=var/evidence

# Damgada kullanılacak yazı tipi (ST-040). Boş bırakılırsa sunucudaki
# bilinen yollar denenir (Windows Segoe UI/Arial, Linux DejaVu/Liberation/
# Noto). **Türkçe harfleri olan** bir yazı tipi bulunamazsa damga
# basılmaz ve her turda uyarı yazılır: "Kadıköy" kutu kutu çıkmasın.
# İnce üretim imajlarında yazı tipi paketi genelde yoktur — ya
# fonts-dejavu-core kurun ya da buraya bir .ttf yolu yazın.
STAMP_FONT_PATH=

# Panel geliştirmede Vite vekili kullanıyor; ayrı kaynaktan çağrılacaksa
# buraya yazılır. Joker (*) kabul edilmez.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

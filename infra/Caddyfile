# Panelin, saha istemcisinin ve API'nin giriş kapısı.
#
# `SITE_ADRESI` bir alan adıysa Caddy sertifikayı kendi alır ve yeniler
# (Let's Encrypt). Yerelde `:8080` verilir, sertifika devreye girmez.
#
# Panel ile API **aynı kaynakta**: `/api` buradan arkaya aktarılıyor.
# Böylece tarayıcı açısından tek site var — CORS dağıtımda devreye
# girmiyor ve imzalı kanıt bağlantıları (göreli adresler) çalışıyor.
#
# `SAHA_ADRESI` ikinci bir alan adı (örn. saha.ornek.com): aynı paket,
# aynı kap, **ayrı kaynak**. Ayrı kaynak olmasının tek sebebi oturum:
# tarayıcı deposu kaynağa bağlı olduğu için merkez ve saha aynı
# bilgisayarda aynı anda farklı kişi olarak açılabiliyor. Boş
# bırakılırsa kap içinde yayımlanmamış bir porta bağlanır ve dışarıdan
# görünmez.

(ortak) {
	encode gzip

	handle /api/* {
		reverse_proxy {$API_ADRESI:api:8000}
	}

	handle {
		root * /srv

		# Sıra burada önemli: `route` yazıldığı sırayı koruyor. Yoksa
		# Caddy yönergeleri kendi sırasına diziyor ve `try_files`
		# `respond`tan önce koşup yolu index.html'e çeviriyor — o
		# noktadan sonra "bu dosya yok mu" diye sormanın anlamı kalmaz.
		route {
			# Nokta ile başlayan yol parçası hiç servis edilmiyor:
			# /.env, /.git/config, /.vscode/sftp.json. Sunucuda zaten
			# yoklar (kökte index.html ve assets/ var), ama SPA kuralı
			# hepsine 200 döndürüyordu ve tarayan bota "buldum" gibi
			# görünüyordu.
			@gizli path_regexp (^|/)\.
			respond @gizli 404

			# Dosya gibi görünen ama olmayan yol da 404: SPA kuralı
			# yalnızca gezinme yollarına uygulanmalı.
			@eksik_dosya {
				not file
				path_regexp \.[A-Za-z0-9]{1,10}$
			}
			respond @eksik_dosya 404

			# Tek sayfa uygulaması: bilinmeyen **gezinme** yolu
			# index.html'e düşer, yoksa tarayıcıdan yenilemede 404
			# alınır (/dogrula/<kod> böyle çalışıyor).
			try_files {path} /index.html
			file_server
		}
	}

	header {
		# Panel kendi kaynağından çalışıyor; dışarıdan gömülmesin.
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}

{$SITE_ADRESI::8080} {
	import ortak
}

{$SAHA_ADRESI::8081} {
	import ortak
}

# Dağıtım ortam değişkenleri. Kopyalayın: cp infra/.env.ornek .env
#
# .env **asla commit edilmez** (.gitignore). Üretim gizli anahtarları
# yalnızca Türkiye'deki üretim ortamının kasasında durur; staging ve
# CI ayrı anahtar setiyle çalışır (ADR-0012).

# staging | prod
ENVIRONMENT=staging
LOG_LEVEL=INFO

# --- Veritabanı -------------------------------------------------------
POSTGRES_USER=talimatname_owner
POSTGRES_DB=talimatname
# Uzun ve rastgele olsun: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Belirteç imzası (RS256) ------------------------------------------
# Üretimde zorunlu. Üretmek için:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out ozel.pem
#   openssl rsa -in ozel.pem -pubout -out acik.pem
# `.env` tek satırlık: PEM'in yeni satırları \n ile yazılır ve
# değer tırnaksız kalır (Compose çok satırlı değer okumuyor;
# uygulama kaçışı geri açıyor). Tek satıra indirmek için:
#   python3 -c 'import pathlib;print(pathlib.Path("ozel.pem").read_text().strip().replace(chr(10), chr(92)+"n"))'
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# --- Nesne depolama (kanıt dosyaları) ---------------------------------
# Varsayılan: compose içindeki MinIO. Üretimde sağlayıcının kovası
# yazılır ve `minio` servisi compose'dan çıkarılır.
# **Üretim kovası Türkiye'de olmalı** (ADR-0003): fotoğraf kişisel
# veri sayılabilir.
OBJECT_STORE_ENDPOINT=http://minio:9000
OBJECT_STORE_BUCKET=talimatname-kanit
OBJECT_STORE_ACCESS_KEY=talimatname
OBJECT_STORE_SECRET_KEY=

# --- Site ------------------------------------------------------------
# Yerelde ":80" bırakın, tarayıcıdan http://localhost:8080 açın.
# Alan adı verirseniz (ör. staging.talimatname.app) Caddy sertifikayı
# kendi alır; o zaman WEB_PORT=80 ve WEB_TLS_PORT=443 yapın.
SITE_ADRESI=:80
WEB_PORT=8080
WEB_TLS_PORT=8443

# Panel API ile aynı kaynaktan servis ediliyor; CORS yalnızca ayrı
# alan adından çağıran bir istemci olursa gerekir.
CORS_ORIGINS=http://localhost:8080

# --- Belge doğrulama (FR-1218) ---------------------------------------
# Panelin **dışarıdan görünen** adresi. Rapor PDF'lerinin altına
# <PANEL_URL>/dogrula/<kod> bağlantısı basılır: denetçi kâğıttaki
# adresi tarayıcıya yazıp kaydı görür.
#
# Boş bırakılabilir: o zaman kâğıt bağlantı yerine sayfanın adını
# yazar. Yanlış bir adres basmak, doğrulanamayan bir belge demek
# olurdu — bu yüzden varsayılan bir adres uydurmuyoruz.
PANEL_URL=http://localhost:8080

# --- Arka plan çıktıları (FR-1217) -----------------------------------
# Bu sayıdan çok çalıştırma kapsayan dönem raporu istek içinde değil
# zamanlayıcı sürecinde üretilir; kullanıcı listeden indirir.
#
# Ürün kuralı değil **kapasite** kararı: güçlü bir sunucuda daha büyük
# rapor istek içinde üretilebilir, zayıf olanda eşik düşürülür.
EXPORT_BACKGROUND_THRESHOLD=500

# --- Günlük çıpası · RFC 3161 (FR-1302) ------------------------------
# Olay günlüğünün zinciri, kayıtların **tek tek** değiştirilmesini
# görünür kılar. Kapatamadığı tek senaryo şu: veritabanına yazabilen
# biri zinciri baştan hesaplarsa her şey yine tutar.
#
# Zaman damgası bunu kapatıyor: günün kökü (son kaydın özeti) günde
# bir kez bağımsız bir otoriteye tarihletiliyor ve damga saklanıyor.
# Damgadan sonra o ana kadarki tarihi yeniden yazan biri, damgayla
# tutmayan bir zincir bırakır.
#
# Boş bırakılabilir — o zaman çıpalama **kapalıdır** ve bunu ürün
# saklamaz: /health ve `izi_dogrula` durumu söyler.
#
# Sağlayıcı seçimi: Türkiye'de zaman damgası hizmetini ESHS'ler
# veriyor (5070 sayılı kanun). Damganın hukuki ağırlığı sağlayıcıya
# bağlı; bu bir hukuk kararıdır, ürün kararı değil. Teknik olarak
# RFC 3161 konuşan her sunucu çalışır.
TSA_URL=
# Sunucu belirli bir politika istiyorsa (OID); çoğu istemiyor.
TSA_POLICY_OID=
TSA_TIMEOUT_SECONDS=10

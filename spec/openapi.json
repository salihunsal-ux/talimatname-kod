{
  "openapi": "3.1.0",
  "info": {
    "title": "Talimatname API",
    "description": "Kanıtlı görev listesi API'si (v1 çekirdek). Hatalar RFC 9457 problem+json biçiminde döner.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "sistem"
        ],
        "summary": "Canlılık ve yapılandırma özeti",
        "description": "Sürüm, ortam ve bağımlılıkların yapılandırılmış olup olmadığı.\n\nVeritabanına **bağlanmaz**: canlılık kontrolü bağımlılıkların\ndurumuna göre kırmızı olmamalı (hazırlık kontrolü ayrı gelecek).",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/branches": {
      "get": {
        "tags": [
          "organizasyon"
        ],
        "summary": "Bölge → şube ağacı",
        "operationId": "sube_agaci_api_v1_branches_get",
        "parameters": [
          {
            "name": "include_inactive",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Include Inactive"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BolgeDugumu"
                  },
                  "title": "Response Sube Agaci Api V1 Branches Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "organizasyon"
        ],
        "summary": "Şube ekle",
        "operationId": "sube_ekle_api_v1_branches_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubeGirdisi"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubeOzet"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/branches/{branch_id}": {
      "get": {
        "tags": [
          "organizasyon"
        ],
        "summary": "Şube detayı",
        "operationId": "sube_detayi_api_v1_branches__branch_id__get",
        "parameters": [
          {
            "name": "branch_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Branch Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubeDetay"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "organizasyon"
        ],
        "summary": "Şube güncelle",
        "operationId": "sube_guncelle_api_v1_branches__branch_id__patch",
        "parameters": [
          {
            "name": "branch_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Branch Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubeGirdisi"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubeOzet"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/branches/{branch_id}/deactivate": {
      "post": {
        "tags": [
          "organizasyon"
        ],
        "summary": "Şubeyi pasifleştir",
        "description": "Silme değil: geçmiş kayıtlar ve kanıtlar durur (BR-22).",
        "operationId": "sube_pasiflestir_api_v1_branches__branch_id__deactivate_post",
        "parameters": [
          {
            "name": "branch_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Branch Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubeOzet"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/branches/{branch_id}/activate": {
      "post": {
        "tags": [
          "organizasyon"
        ],
        "summary": "Şubeyi yeniden aktif et",
        "operationId": "sube_aktif_et_api_v1_branches__branch_id__activate_post",
        "parameters": [
          {
            "name": "branch_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Branch Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubeOzet"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BolgeDugumu": {
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "branches": {
            "items": {
              "$ref": "#/components/schemas/SubeOzet"
            },
            "type": "array",
            "title": "Branches"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "branches"
        ],
        "title": "BolgeDugumu"
      },
      "CalismaSaati": {
        "properties": {
          "weekday": {
            "type": "integer",
            "maximum": 6.0,
            "minimum": 0.0,
            "title": "Weekday",
            "description": "0 = Pazartesi"
          },
          "weekday_name": {
            "type": "string",
            "title": "Weekday Name"
          },
          "open_time": {
            "anyOf": [
              {
                "type": "string",
                "format": "time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Open Time"
          },
          "close_time": {
            "anyOf": [
              {
                "type": "string",
                "format": "time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Close Time"
          }
        },
        "type": "object",
        "required": [
          "weekday",
          "weekday_name"
        ],
        "title": "CalismaSaati",
        "description": "Bir günün açılış/kapanışı. `null` gün = kapalı."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "description": "API sürümü"
          },
          "environment": {
            "type": "string",
            "title": "Environment",
            "description": "dev | test | staging | prod"
          },
          "database_configured": {
            "type": "boolean",
            "title": "Database Configured",
            "description": "DATABASE_URL tanımlı mı"
          },
          "object_store_configured": {
            "type": "boolean",
            "title": "Object Store Configured",
            "description": "Nesne depolama uç noktası tanımlı mı"
          }
        },
        "type": "object",
        "required": [
          "version",
          "environment",
          "database_configured",
          "object_store_configured"
        ],
        "title": "HealthResponse",
        "description": "Canlılık yanıtı. Şema açıkça tanımlı: istemci tipleri bundan üretilir."
      },
      "IstasyonOzet": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "kind"
        ],
        "title": "IstasyonOzet"
      },
      "SubeDetay": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ],
            "title": "Status"
          },
          "region_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Region Id"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone"
          },
          "open_days": {
            "type": "integer",
            "title": "Open Days",
            "description": "Haftada açık gün sayısı"
          },
          "address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Address"
          },
          "business_hours": {
            "items": {
              "$ref": "#/components/schemas/CalismaSaati"
            },
            "type": "array",
            "title": "Business Hours"
          },
          "stations": {
            "items": {
              "$ref": "#/components/schemas/IstasyonOzet"
            },
            "type": "array",
            "title": "Stations"
          }
        },
        "type": "object",
        "required": [
          "id",
          "code",
          "name",
          "status",
          "timezone",
          "open_days",
          "business_hours",
          "stations"
        ],
        "title": "SubeDetay"
      },
      "SubeGirdisi": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 16,
            "minLength": 2,
            "title": "Code",
            "examples": [
              "KDK"
            ]
          },
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name",
            "examples": [
              "Kadıköy"
            ]
          },
          "timezone": {
            "type": "string",
            "title": "Timezone",
            "default": "Europe/Istanbul"
          },
          "region_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Region Id"
          },
          "address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Address"
          },
          "business_hours": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/CalismaSaati"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Business Hours"
          }
        },
        "type": "object",
        "required": [
          "code",
          "name"
        ],
        "title": "SubeGirdisi",
        "description": "Şube oluşturma/güncelleme gövdesi.\n\nÇalışma saatleri verilmezse 08:00–23:00 her gün uygulanır: kurulum\nsihirbazının varsayılanı (FR-1401); şube sonradan düzeltir."
      },
      "SubeOzet": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ],
            "title": "Status"
          },
          "region_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Region Id"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone"
          },
          "open_days": {
            "type": "integer",
            "title": "Open Days",
            "description": "Haftada açık gün sayısı"
          }
        },
        "type": "object",
        "required": [
          "id",
          "code",
          "name",
          "status",
          "timezone",
          "open_days"
        ],
        "title": "SubeOzet"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}